--- 2026-09-17/scripts/check-wildlife-photos.py
+++ 2026-10-29/scripts/check-wildlife-photos.py
@@ -0,0 +1,33 @@
+"""Decode source photographs, record their true dimensions, and build QA contact sheets."""
+from pathlib import Path
+from PIL import Image, ImageOps, ImageDraw, ImageFont
+import hashlib
+import json
+
+root = Path(__file__).resolve().parent.parent
+manifest_path = root / 'server/wildlife-photos.json'
+photos = json.loads(manifest_path.read_text(encoding='utf-8-sig'))
+font = ImageFont.truetype('C:/Windows/Fonts/msyh.ttc', 18)
+small = ImageFont.truetype('C:/Windows/Fonts/arial.ttf', 13)
+review = root / 'tmp/wildlife-photo-review'
+review.mkdir(parents=True, exist_ok=True)
+for offset in range(0, len(photos), 16):
+    sheet = Image.new('RGB', (1200, 1000), '#f5f2eb')
+    draw = ImageDraw.Draw(sheet)
+    for i, photo in enumerate(photos[offset:offset+16]):
+        path = root / 'public' / photo['path'].lstrip('/')
+        with Image.open(path) as image:
+            assert image.format == 'JPEG', path
+            image.load()
+            width, height = image.size
+            assert min(width, height) >= 200, path
+            photo['width'], photo['height'] = width, height
+            photo['sha256'] = hashlib.sha256(path.read_bytes()).hexdigest()
+            preview = ImageOps.contain(image.convert('RGB'), (280, 190))
+            x, y = (i % 4) * 300, (i // 4) * 250
+            sheet.paste(preview, (x + (300 - preview.width) // 2, y + (190 - preview.height) // 2))
+            draw.text((x + 10, y + 196), f"{photo['recordId']}  {photo['name']}", font=font, fill='#26232c')
+            draw.text((x + 10, y + 224), photo['scientificName'][:37], font=small, fill='#555555')
+    sheet.save(review / f'contact-{offset//16+1}.jpg', quality=92)
+manifest_path.write_text(json.dumps(photos, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
+print(f'Validated {len(photos)} JPEG photographs; total {sum((root / "public" / p["path"].lstrip("/")).stat().st_size for p in photos):,} bytes.')

--- 2026-09-17/scripts/fetch-globe-assets.mjs
+++ 2026-10-29/scripts/fetch-globe-assets.mjs
@@ -0,0 +1,22 @@
+import { mkdir, writeFile, readFile, access } from 'node:fs/promises';
+import { resolve, dirname } from 'node:path';
+const files = [
+  ['public/vendor/d3-array.min.js','https://cdn.jsdelivr.net/npm/d3-array@3.2.4/dist/d3-array.min.js'],
+  ['public/vendor/d3-geo.min.js','https://cdn.jsdelivr.net/npm/d3-geo@3.1.1/dist/d3-geo.min.js'],
+  ['public/vendor/d3-array.LICENSE','https://cdn.jsdelivr.net/npm/d3-array@3.2.4/LICENSE'],
+  ['public/vendor/d3-geo.LICENSE','https://cdn.jsdelivr.net/npm/d3-geo@3.1.1/LICENSE'],
+  ['public/assets/world-land-50m.geojson','https://raw.githubusercontent.com/nvkelso/natural-earth-vector/v5.1.2/geojson/ne_50m_land.geojson'],
+  ['public/assets/globe/red-panda.png','https://www.figma.com/api/mcp/asset/a4b6a06d-0273-40e6-afb6-3bce6d300a7b/1962a.png'],
+  ['public/assets/globe/red-panda-ring.svg','https://www.figma.com/api/mcp/asset/a4b6a06d-0273-40e6-afb6-3bce6d300a7b/7ffd7.svg']
+];
+const manifest=JSON.parse(await readFile('docs/figma-globe-assets.json','utf8'));
+files.push(...manifest.flatMap(n=>n.assets.map(a=>['public'+a.path,a.url])));
+for (const [path,url] of files) {
+  try { await access(path); continue; } catch {}
+  const response=await fetch(url,{signal:AbortSignal.timeout(60000)});
+  if(!response.ok)throw new Error(`${path}: HTTP ${response.status}`);
+  const bytes=Buffer.from(await response.arrayBuffer());
+  await mkdir(dirname(resolve(path)),{recursive:true});
+  await writeFile(resolve(path),bytes);
+  console.log(`${path}: ${bytes.length} bytes`);
+}

