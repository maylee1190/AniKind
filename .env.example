HOST=127.0.0.1
PORT=4173
NODE_ENV=development
# Public design examples are disabled automatically in production.
DEMO_CONTENT=true
# disabled | demo | http. Demo is a local template, never an AI model.
AI_MODE=disabled
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=5
AI_PLATFORM_DAILY_LIMIT=100
# Required to validate MP4/MOV/M4A/MP3 duration. Absolute ffprobe path or command.
FFPROBE_PATH=
